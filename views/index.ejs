<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>PawFinder - Adoption Site</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/home.css">
</head>

<body>

<header class="pf-header-strip">
    <div class="pf-header-inner">
        <img src="/Images/logo.png" alt="PawFinder Logo" class="pf-site-logo" width="200" height="200">
    </div>
</header>

<nav class="pf-top-nav">
    <a href="/">Home</a>
    <a href="/how-it-works">How it works</a>
    <a href="/dog-submission">Send for Adoption</a>
    <a href="/dogs/available-dogs">Available Dogs</a>
    <a href="/shelter/login" class="adoption-center-btn">Adoption Center login</a>
</nav>


<main>
    <section class="hero">
        <div class="hero-text">
            <h2>Adopt, don't shop</h2>
            <p>PawFinder connects families with dogs who are waiting for a second chance.</p>
            <div class="hero-buttons">
                <a href="/dogs/available-dogs" title="Available dogs Page" class="btn primary-btn">Browse dogs</a>
                <a href="/how-it-works" title="How it works page" class="btn secondary-btn">Learn more</a>
            </div>
        </div>

        <div class="hero-image">
            <img src="/Images/adopt.png" alt="Dogs illustration">
        </div>
    </section>
    
    <section class="video-section">
        <h2>See how adoption changes lives</h2>

        <video width="75%" controls>
        <source src="/videos/hero-video.mp4" type="video/mp4">
        Your browser does not support HTML5 video.
        </video>
    </section>

   <section>
    <h2>How it will work</h2>

    <div class="how-it-works-layout">
        <!-- Left side -->
        <ol class="steps">
            <li>Search dogs</li>
            <li>View details</li>
            <li>Send Request</li>
            <li>Contact adoption site</li>
        </ol>

        <!-- Right side -->
        <div class="quiz-box">
            <p>Want to test your knowledge about dogs?</p>
            <a href="/quiz" class="btn primary-btn">Take the quiz</a>
        </div>
    </div>
   </section>


    <section>
        <h2>Dog categories</h2>
        <p>We have all kinds of dogs - Find dogs that fit your lifestyle!</p>
        <div class="category-grid">
            <a href="/dogs/available-dogs" class="category-card" >Family Friendly</a>
            <a href="/dogs/available-dogs" class="category-card" >Active Dogs</a>
            <a href="/dogs/available-dogs" class="category-card" >Calm Dogs</a>
        </div>
    </section>

</main>

<footer class="site-footer">
    <p>© 2026 PawFinder - Adoption Website - Web Programing Course</p>
    <p>This page contains placeholders for future features.</p>
</footer>

</body>
</html>